#!/usr/bin/env bash
# tests/run — run every tests/test-*.sh, report aggregate result.
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
rc=0
for t in "$DIR"/test-*.sh; do
  [ -e "$t" ] || continue
  printf '== %s ==\n' "${t##*/}"
  bash "$t" || rc=1
done
[ "$rc" -eq 0 ] && printf '\nALL TESTS PASSED\n' || printf '\nSOME TESTS FAILED\n'
exit "$rc"
