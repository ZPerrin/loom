#!/usr/bin/env bash
# doc-slicer — SessionStart context for loom (bash 3.2 + awk, no deps).
# Emits a preamble, a git "Bearings" block, then harvests every section whose header is
# in context.slice_headers across the discovered managed-doc set, each prefixed with a
# context.inject_fields annotation (frontmatter values; `location` = the source path).
# Path-free: slices are found by discovery + header, so moving a file never breaks them.
# Usage: doc-slicer                                    — SessionStart slice (hook mode).
#        doc-slicer --header <name> [path-filter…]     — on-demand query: emit just that
#          section (same provenance annotation) from every managed doc that has it,
#          optionally narrowed to docs whose path contains a filter. "<name>" may be bare
#          ("Overview") or exact ("## Overview" / "### Deep"). Exit 1 if nothing matched.
#        doc-slicer --spec <capability> [selector]     — one spec, found by its first line
#          "# Capability: <slug>" among managed kind: spec docs, never by path. A selector
#          narrows it: a requirement id (R-TOKEN-NNN, the block with its scenarios), an
#          invariant or non-goal id (INV-n, N-n, the one line), a section name (bare or
#          exact), or "ids" (every requirement id with its title). Exit 1 if nothing matched.
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PARSE_AWK="$SELF_DIR/lib/parse-toml.awk"
. "$SELF_DIR/lib/discover.sh"
ROOT="$(loom_repo_root)"

MODE="session"
QUERY_HDR=""; QUERY_CAP=""; QUERY_SEL=""
if [ "${1:-}" = "--header" ]; then
  MODE="query"; shift
  QUERY_HDR="${1:-}"
  [ -n "$QUERY_HDR" ] || { echo "doc-slicer --header: missing header name" >&2; exit 2; }
  shift
  case "$QUERY_HDR" in "#"*) ;; *) QUERY_HDR="## $QUERY_HDR" ;; esac   # bare name → H2
elif [ "${1:-}" = "--spec" ]; then
  MODE="spec"; shift
  QUERY_CAP="${1:-}"
  [ -n "$QUERY_CAP" ] || { echo "doc-slicer --spec: missing capability name" >&2; exit 2; }
  shift
  QUERY_SEL="${1:-}"
fi

DEFAULT_CFG='context.recent_commits=15
context.slice_headers=## Now
context.inject_fields=updated
context.inject_fields=kind
context.inject_fields=location'
CONF="$ROOT/.loom/loom.toml"
if [ -f "$CONF" ]; then
  CFG="$(awk -f "$PARSE_AWK" "$CONF")" || CFG="$DEFAULT_CFG"
else
  CFG="$DEFAULT_CFG"
fi
cfg_get() { printf '%s\n' "$CFG" | awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print}'; }

COMMITS="$(cfg_get context.recent_commits)"; COMMITS="${COMMITS:-15}"
case "$COMMITS" in ''|*[!0-9]*) COMMITS=15 ;; esac
SLICE_HEADERS="$(cfg_get context.slice_headers)"
INJECT_FIELDS="$(cfg_get context.inject_fields)"

# print the markdown under "<header>" in <file>, header line excluded, stop at next "## ".
# Fenced code (``` or ~~~) is body, never a header: a fenced example of a section is not one,
# and a fenced "## " line does not end the section it sits in.
# Match is exact ($0 == hdr); trailing whitespace in the file would prevent a match.
emit_section() { # $1=file $2=header
  [ -f "$1" ] || return 0
  awk -v hdr="$2" '
    /^ ? ? ?(```|~~~)/ { if (cap) print; fence = !fence; next }
    fence { if (cap) print; next }
    $0 == hdr { cap = 1; next }
    cap && /^## / { exit }
    cap { print }
  ' "$1"
}

# the capability a spec names: its first content line past the frontmatter is
# "# Capability: <slug>". Prints the slug, or nothing for a doc that opens any other way.
spec_capability() { # $1=file
  awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm { if ($0 ~ /^---[ \t]*$/) fm = 0; next }
    /^[ \t]*$/ { next }
    { if ($0 ~ /^# Capability: /) { sub(/^# Capability: /, ""); print }; exit }
  ' "$1"
}

# one block of a spec, by selector: none = the document past its frontmatter; "ids" = every
# requirement id with its title; R-TOKEN-NNN = that requirement through its scenarios, up to
# the next ### or ## line; INV-n / N-n = that one line; anything else = a section by header.
emit_spec() { # $1=file $2=selector
  case "$2" in
    "")  awk 'NR == 1 && $0 == "---" { fm = 1; next } fm { if ($0 ~ /^---[ \t]*$/) fm = 0; next } { print }' "$1" ;;
    ids) awk '/^### R-/ { sub(/^### /, ""); print }' "$1" ;;
    R-*) awk -v id="$2" '
           index($0, "### " id ": ") == 1 { cap = 1; print; next }
           cap && (/^### / || /^## /) { exit }
           cap && /^[ \t]*$/ { blank++; next }
           cap { for (; blank > 0; blank--) print ""; print }
         ' "$1" ;;
    INV-*|N-*) awk -v id="$2" 'index($0, "- " id ": ") == 1 { print }' "$1" ;;
    *)   hdr="$2"; case "$hdr" in "#"*) ;; *) hdr="## $hdr" ;; esac; emit_section "$1" "$hdr" ;;
  esac
}

# one-line annotation for a managed doc, built from INJECT_FIELDS in order.
annotate() { # $1=rel
  local rel="$1" abs="$ROOT/$1" out="" field val v
  while IFS= read -r field; do
    [ -n "$field" ] || continue
    case "$field" in
      location) val="$rel" ;;
      *) v="$(frontmatter_field "$abs" "$field")"; [ -n "$v" ] && val="$field: $v" || val="" ;;
    esac
    [ -n "$val" ] && { [ -n "$out" ] && out="$out · $val" || out="$val"; }
  done <<EOF
$INJECT_FIELDS
EOF
  printf '%s' "$out"
}

# --- query mode: one header, on demand — a section instead of a whole-file read ---
if [ "$MODE" = "query" ]; then
  found=""
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if [ "$#" -gt 0 ]; then
      keep=""
      for flt in "$@"; do case "$rel" in *"$flt"*) keep=1 ;; esac; done
      [ -n "$keep" ] || continue
    fi
    body="$(emit_section "$ROOT/$rel" "$QUERY_HDR")"
    [ -n "$body" ] || continue
    found=1
    ann="$(annotate "$rel")"
    [ -n "$ann" ] && printf '_%s_\n\n' "$ann"
    printf '%s\n\n' "$body"
  done <<EOF
$(managed_docs "$ROOT")
EOF
  [ -n "$found" ] && exit 0
  echo "doc-slicer --header: no managed doc has a section \"$QUERY_HDR\"${*:+ matching: $*}" >&2
  exit 1
fi

# --- spec mode: one capability's spec, or one block of it, found by its Capability line ---
if [ "$MODE" = "spec" ]; then
  found=""; hit=""
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    [ "$(frontmatter_field "$ROOT/$rel" kind)" = "spec" ] || continue
    [ "$(spec_capability "$ROOT/$rel")" = "$QUERY_CAP" ] || continue
    found=1
    body="$(emit_spec "$ROOT/$rel" "$QUERY_SEL")"
    [ -n "$body" ] || continue
    hit=1
    ann="$(annotate "$rel")"
    [ -n "$ann" ] && printf '_%s_\n\n' "$ann"
    printf '%s\n\n' "$body"
  done <<EOF
$(managed_docs "$ROOT")
EOF
  [ -n "$hit" ] && exit 0
  if [ -n "$found" ]; then echo "doc-slicer --spec: no block \"$QUERY_SEL\" in capability $QUERY_CAP" >&2
  else echo "doc-slicer --spec: no managed spec names capability \"$QUERY_CAP\"" >&2; fi
  exit 1
fi

# --- session mode: the SessionStart slice ---
printf '_The slices below are your opening context — the next ring of progressive disclosure past AGENTS.md. When a task goes past a slice, pull the next section on demand — `bash "%s/doc-slicer" --header "<name>" [path-filter]`, or one spec block — `bash "%s/doc-slicer" --spec <capability> [id|section|ids]` — instead of reading whole files._\n\n' "$SELF_DIR" "$SELF_DIR"

printf '## Bearings — recent activity (from git)\n\n_Where the work just was, newest first:_\n\n'
git -C "$ROOT" log --oneline -"$COMMITS" 2>/dev/null || echo "(no git history)"
printf '\n'

# Harvest configured headers across the managed set (cache the set once).
MANAGED="$(managed_docs "$ROOT")"
while IFS= read -r hdr; do
  [ -n "$hdr" ] || continue
  shown=""
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    body="$(emit_section "$ROOT/$rel" "$hdr")"
    [ -n "$body" ] || continue
    if [ -z "$shown" ]; then printf '## %s\n\n' "${hdr#"## "}"; shown=1; fi
    ann="$(annotate "$rel")"
    [ -n "$ann" ] && printf '_%s_\n\n' "$ann"
    printf '%s\n\n' "$body"
  done <<EOF
$MANAGED
EOF
done <<EOF
$SLICE_HEADERS
EOF
