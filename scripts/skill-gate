#!/usr/bin/env bash
# skill-gate — a loom skill opens with a receipt of what the gate did, the repo's opinion of it,
# and the report of its hook, handed to the model as context before the skill's first step.
#   stdin: the harness payload, or the first argument where a host passes it that way.
#   Registered in hooks/hooks.json on PreToolUse with matcher Skill for Claude's model-invoked
#   skills, and on UserPromptSubmit for typed invocations on either host; an ordinary prompt
#   gets a fast exit. PreToolUse: tool_input.skill names the skill, "loom:warp" or the bare
#   "warp" a host resolved itself; another plugin's "x:warp" is not loom's. UserPromptSubmit:
#   the prompt, when it opens with /loom:<skill>, $loom:<skill>, or the bare /<skill> a host
#   resolved itself, or mentions $<skill> anywhere; Codex's picker wraps a mention as
#   [$loom:<skill>](path) or [$<skill>](path).
#   Only the skill's name is read; a hook takes no input.
# The answer opens with the receipt: the skill, then whether .loom/skills/<skill>.md was read,
# then which hook ran through skill-hook and how it exited, or that there is none, or that the
# config was refused. The opinion and the hook's output follow. A
# skill that sees no receipt for its invocation does the same by hand; that floor is its own
# prose. Exit 0 always: a gate never blocks a skill or a prompt, and a failing hook is reported
# to the skill, whose prose says what it means. A hook may run again for one invocation;
# tolerating the repeat is the hook's job.
set -u
SELF="$(cd "$(dirname "$0")" && pwd)"
. "$SELF/lib/discover.sh"
SKILLS="warp weave weft dress spec refine-spec"

# stdin -> one JSON string body: backslash, quote, tab, and CR escaped; lines joined with \n.
json_esc() {
  awk '{ gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "\\r")
         out = out (n++ ? "\\n" : "") $0 }
       END { printf "%s", out }'
}

payload="$(cat 2>/dev/null | tr -d '\n')"
[ -n "$payload" ] || payload="$(printf '%s' "${1:-}" | tr -d '\n')"
q='"'
event=""
case "$payload" in *"${q}hook_event_name${q}"*)
  event="${payload#*"${q}hook_event_name${q}"}"; event="${event#*$q}"; event="${event%%$q*}" ;;
esac
if [ "$event" = "UserPromptSubmit" ]; then
  case "$payload" in *"${q}prompt${q}"*) ;; *) exit 0 ;; esac
  prompt="${payload#*"${q}prompt${q}"}"; prompt="${prompt#*$q}"
  case "$prompt" in
    /loom:*|\$loom:*)                      # the name ends at a space, an escape, or the string's close
      skill="${prompt#?loom:}"; skill="${skill%%[[:space:]]*}"; skill="${skill%%\\*}"; skill="${skill%%\"*}" ;;
    /*)                                    # a bare /warp the host resolved itself; the checks below decide
      skill="${prompt#/}"; skill="${skill%%[[:space:]]*}"; skill="${skill%%\\*}"; skill="${skill%%\"*}" ;;
    *) skill=""                            # a mention is looked for in the whole payload, so a quote before it hides nothing
       for s in $SKILLS; do
         case "$payload" in
           *"[\$loom:$s]("*|*"[\$$s]("*|*"\$$s\""*|*"\$$s "*|*"\$$s\\"*)
             skill="$s"; break ;;
         esac
       done
       [ -n "$skill" ] || exit 0 ;;
  esac
else
  event="PreToolUse"
  case "$payload" in *"${q}tool_name${q}"*"${q}Skill${q}"*"${q}skill${q}"*) ;; *) exit 0 ;; esac
  skill="${payload#*"${q}skill${q}"}"; skill="${skill#*$q}"; skill="${skill%%$q*}"
  case "$skill" in loom:*) skill="${skill#loom:}" ;; *:*) exit 0 ;; esac
fi
case "$skill" in ""|*[!a-z-]*) exit 0 ;; esac          # a skill name is lowercase letters and hyphens
case " $SKILLS " in *" $skill "*) ;; *) exit 0 ;; esac
ROOT="$(loom_repo_root)"

# The opinion: the file past its frontmatter, or why there is nothing to carry.
f=".loom/skills/$skill.md"; body=""; opinion="none"
if [ -f "$ROOT/$f" ]; then
  if [ -r "$ROOT/$f" ]; then
    body="$(awk 'NR == 1 && $0 == "---" { fm = 1; next } fm { if ($0 ~ /^---[ \t]*$/) fm = 0; next } { print }' "$ROOT/$f")"
    if [ -n "$body" ]; then opinion="read $f"; else opinion="empty $f"; fi
  else opinion="unreadable $f"; fi
fi

# The hook: skill-hook names it first (3 none, 2 config refused), then runs it. The gate
# interprets none of it; the exit code and what it printed reach the skill.
name="$( (cd "$ROOT" && bash "$SELF/skill-hook" --name "$skill") 2>&1 )"; rc=$?
report=""
case "$rc" in
  3) hook="none" ;;
  2) hook="refused, exit 2, .loom/loom.toml unparseable"; report="$name" ;;
  *) report="$( (cd "$ROOT" && bash "$SELF/skill-hook" "$skill") 2>&1 )"; rc=$?
     if [ "$rc" -eq 0 ]; then hook="ran $name, exit 0"; else hook="failed $name, exit $rc"; fi ;;
esac

ctx="loom gate: $skill
opinion: $opinion
hook: $hook"
[ -n "$body" ] && ctx="$ctx

Repo opinion for $skill, from $f, layered over the skill you are about to load:

$body"
case "$rc" in
  3) ;;
  0) [ -n "$report" ] && ctx="$ctx

The $skill hook ran at invocation and printed:

$report" ;;
  *) ctx="$ctx

The $skill hook exited $rc at invocation:

$report" ;;
esac
printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event" "$(printf '%s\n' "$ctx" | json_esc)"
exit 0
