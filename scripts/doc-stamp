#!/usr/bin/env bash
# doc-stamp — idempotently set frontmatter fields on a managed doc (bash 3.2 + awk, no deps).
# Usage: doc-stamp <file> key=value [key=value ...]
#   - No frontmatter yet: prepends a block with the given keys, in argument order.
#   - Has frontmatter: sets/replaces the named top-level keys in place (order preserved),
#     appending any new ones before the closing `---`. Nested/indented keys are left alone.
# Runs under bash, so shell-reserved names (e.g. zsh's `status`) never bite. Idempotent:
# the same args twice produce the same file. dress's Write step and weave both call this.
set -u

die() { printf 'doc-stamp: %s\n' "$1" >&2; exit 1; }

[ $# -ge 2 ] || die "usage: doc-stamp <file> key=value [key=value ...]"
FILE="$1"; shift
[ -f "$FILE" ] || die "no such file: $FILE"

KEYS=""; VALS=""
for kv in "$@"; do
  case "$kv" in
    *=*) k="${kv%%=*}"; v="${kv#*=}" ;;
    *)   die "argument not key=value: $kv" ;;
  esac
  [ -n "$k" ] || die "empty key in: $kv"
  KEYS="$KEYS$k"$'\n'
  VALS="$VALS$v"$'\n'
done

TMP="$(mktemp)" || die "mktemp failed"
DOCSTAMP_KEYS="$KEYS" DOCSTAMP_VALS="$VALS" awk '
  function emit_new_block(   i, key) {
    print "---"
    for (i = 1; i <= nk; i++) { key = ord[i]; print key ": " want[key] }
    print "---"
  }
  BEGIN {
    n = split(ENVIRON["DOCSTAMP_KEYS"], Karr, "\n"); split(ENVIRON["DOCSTAMP_VALS"], Varr, "\n")
    nk = 0
    for (i = 1; i <= n; i++) {
      if (Karr[i] == "") continue
      nk++; ord[nk] = Karr[i]; want[Karr[i]] = Varr[i]
    }
    state = "start"
  }
  state == "start" {
    if ($0 == "---") { state = "infm"; print; next }
    emit_new_block(); state = "body"; print; next
  }
  state == "infm" {
    if ($0 == "---") {
      for (i = 1; i <= nk; i++) { key = ord[i]; if (!seen[key]) print key ": " want[key] }
      print; state = "body"; next
    }
    if (match($0, /^[A-Za-z0-9_-]+:/)) {
      key = substr($0, 1, RLENGTH - 1)
      if (key in want) { print key ": " want[key]; seen[key] = 1; next }
    }
    print; next
  }
  { print }
' "$FILE" > "$TMP" || { rm -f "$TMP"; die "awk failed on $FILE"; }

cat "$TMP" > "$FILE"   # cat-in-place preserves the original file's mode/owner
rm -f "$TMP"
