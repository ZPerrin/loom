#!/usr/bin/env bash
# doc-linter — doc hygiene for loom-managed Markdown (bash 3.2 + awk, no deps).
# Managed set = discovery (frontmatter with a kind: key), via scripts/lib/discover.sh.
# Checks: BROKEN, CODELINK, MISSING (links); FRONTMATTER (kind/status/updated); PLACEMENT (loom-config docs).
# Config: <repo>/.loom/loom.toml ([lint] kinds/statuses) or embedded defaults.
# Usage: doc-linter                 — full lint of the managed set.
#        doc-linter --links [FILE…] — link checks only (BROKEN/CODELINK/MISSING) over the given
#                                      files, or the whole non-excluded doc universe if none given;
#                                      frontmatter not required, so dress can preview the link
#                                      findings adoption will create before anything is stamped.
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PARSE_AWK="$SELF_DIR/lib/parse-toml.awk"
. "$SELF_DIR/lib/discover.sh"
ROOT="$(loom_repo_root)"

# --- mode: default full lint; --links = prospective link-only check (no frontmatter needed) ---
MODE="full"
if [ "${1:-}" = "--links" ]; then MODE="links"; shift; fi

# --- config: normalized "table.key=value" text, from loom.toml or defaults ---
DEFAULT_CFG='lint.kinds=readme
lint.kinds=reference
lint.kinds=roadmap
lint.kinds=spec
lint.kinds=plan
lint.kinds=design
lint.kinds=review
lint.kinds=loom-config
lint.statuses=living
lint.statuses=hardened
lint.statuses=superseded
lint.statuses=scaffolding
lint.statuses=ideation'
CONF="$ROOT/.loom/loom.toml"
if [ -f "$CONF" ]; then
  CFG="$(awk -f "$PARSE_AWK" "$CONF")" || { echo "doc-linter: bad loom.toml" >&2; exit 2; }
else
  CFG="$DEFAULT_CFG"
fi
cfg_get() { printf '%s\n' "$CFG" | awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print}'; }
default_get() { printf '%s\n' "$DEFAULT_CFG" | awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print}'; }

RAW_KINDS="$(cfg_get lint.kinds)"
RAW_STATUSES="$(cfg_get lint.statuses)"
DEFAULT_KINDS="$(default_get lint.kinds)"
DEFAULT_STATUSES="$(default_get lint.statuses)"
KINDS="${RAW_KINDS:-$DEFAULT_KINDS}"
STATUSES="${RAW_STATUSES:-$DEFAULT_STATUSES}"
CONFIG_DIR="$(cfg_get skills.config_dir)"; CONFIG_DIR="${CONFIG_DIR:-.loom}"; CONFIG_DIR="${CONFIG_DIR%/}"
SCRIPTS_DIR="$(cfg_get skills.scripts_dir)"; SCRIPTS_DIR="${SCRIPTS_DIR:-.loom/scripts}"; SCRIPTS_DIR="${SCRIPTS_DIR%/}"

# Known skills = basenames of the plugin's skills/ dirs (sibling of scripts/). Empty if absent.
SKILLS=""
for _d in "$SELF_DIR"/../skills/*/; do
  [ -d "$_d" ] || continue
  _b="${_d%/}"; _b="${_b##*/}"
  SKILLS="$SKILLS$_b
"
done

FINDINGS=""
add() { FINDINGS="${FINDINGS}$1
"; }

# Emit, per line of a markdown file, candidate findings. awk extracts; bash resolves
# filesystem existence. Fenced code blocks skipped.
# Output lines: "BROKEN<TAB>href", "CODELINK<TAB>text", "MISSING<TAB>span".
scan_lines() { # $1=file
  awk '
    /^[ \t]*```/ { fence = !fence; next }
    fence { next }
    {
      line = $0
      s = line
      while (match(s, /\[[^]]*\]\([^)]+\)/)) {
        chunk = substr(s, RSTART, RLENGTH)
        href = chunk; sub(/^[^(]*\(/, "", href); sub(/\)$/, "", href)
        sub(/#.*$/, "", href)
        if (href !~ /^(https?:|mailto:)/ && href != "") print "BROKEN\t" href
        if (chunk ~ /^\[`[^`]*`\]\(/) {
          t = chunk; sub(/^\[`/, "", t); sub(/`\].*$/, "", t); print "CODELINK\t" t
        }
        s = substr(s, RSTART + RLENGTH)
      }
      if (line ~ /^[ \t]*[-*][ \t]+`[^`]+`[ \t]*—/ && line !~ /\]\(/) {
        span = line; sub(/^[ \t]*[-*][ \t]+`/, "", span); sub(/`.*$/, "", span)
        if (span ~ /[\/.]/) print "MISSING\t" span
      }
    }
  ' "$1"
}

check_links() { # $1=file
  local f="$1" dir rel kind rest tgt
  dir="$(dirname "$f")"; rel="${f#"$ROOT"/}"
  while IFS=$'\t' read -r kind rest; do
    case "$kind" in
      BROKEN)
        [ -e "$dir/$rest" ] || add "BROKEN   $rel: $rest" ;;
      CODELINK)
        add "CODELINK $rel: \`$rest\` — use plain link text [$rest](…)" ;;
      MISSING)
        tgt="$dir/$rest"
        if [ -e "$tgt" ] && ! git -C "$ROOT" check-ignore -q "$tgt" 2>/dev/null; then
          add "MISSING $rel: list path \`$rest\` should be a link"
        fi ;;
    esac
  done < <(scan_lines "$f")
}

in_list() { printf '%s\n' "$2" | grep -qxF "$1"; }

check_frontmatter() { # $1=file  (every managed doc has frontmatter; validate values)
  local f="$1" rel; rel="${f#"$ROOT"/}"
  local kind status updated line k v
  while IFS= read -r line; do
    [ "$line" = "---" ] && break   # exact close; managed_docs guarantees a well-formed fence
    case "$line" in
      *:*) k="${line%%:*}"; v="${line#*:}"; v="${v# }"
           case "$k" in kind) kind="$v";; status) status="$v";; updated) updated="$v";; esac ;;
    esac
  done < <(tail -n +2 "$f")
  in_list "${kind:-}" "$KINDS" || add "FRONTMATTER $rel: kind=${kind:-} not allowed"
  in_list "${status:-}" "$STATUSES" || add "FRONTMATTER $rel: status=${status:-} not allowed"
  case "${updated:-}" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) add "FRONTMATTER $rel: updated=${updated:-} not an ISO date (YYYY-MM-DD)" ;;
  esac
}

check_placement() { # $1=file $2=kind  — loom-config docs must live at <config_dir>/<skill>.md
  [ "$2" = "loom-config" ] || return 0
  local f="$1" rel dir base; rel="${f#"$ROOT"/}"
  dir="$(dirname "$rel")"; base="$(basename "$rel" .md)"
  if [ "$dir" != "$CONFIG_DIR" ]; then
    add "PLACEMENT $rel: loom-config outside config_dir ($CONFIG_DIR/) — its skill won't find it"
    return
  fi
  if [ -n "$SKILLS" ] && ! in_list "$base" "$SKILLS"; then
    add "PLACEMENT $rel: no skill named '$base' — name a loom-config doc after the skill it configures"
  fi
}

# validate_hook_form <hook-value> — flags only if it names a file under SCRIPTS_DIR that isn't executable.
validate_hook_form() {
  local h first cand
  h="$1"; [ -n "$h" ] || return 0
  first="${h%% *}"                       # first whitespace-delimited token
  case "$first" in
    *[\|\;\&\<\>]*) return 0 ;;           # shell metacharacter → inline command, accept
  esac
  cand="$ROOT/$SCRIPTS_DIR/$first"
  if [ -f "$cand" ] && [ ! -x "$cand" ]; then
    add "HOOK     .loom/loom.toml: hook script $first not executable (chmod +x $SCRIPTS_DIR/$first)"
  fi
}

check_lint_config() {
  [ -f "$CONF" ] || return 0
  [ -n "$RAW_KINDS" ] || add "LINT     .loom/loom.toml: [lint] missing kinds"
  [ -n "$RAW_STATUSES" ] || add "LINT     .loom/loom.toml: [lint] missing statuses"
}

check_warp_config() { # the [warp] section is optional, but required-and-valid iff present
  printf '%s\n' "$CFG" | grep -q '^warp\.' || return 0
  local bc sr sb wt wh
  bc="$(cfg_get warp.branch_convention)"
  sr="$(cfg_get warp.source_repo)"
  sb="$(cfg_get warp.source_branch)"
  wt="$(cfg_get warp.worktree)"
  wh="$(cfg_get warp.hook)"
  [ -n "$bc" ] || add "WARP     .loom/loom.toml: [warp] missing branch_convention"
  [ -n "$sr" ] || add "WARP     .loom/loom.toml: [warp] missing source_repo"
  [ -n "$sb" ] || add "WARP     .loom/loom.toml: [warp] missing source_branch"
  case "$wt" in
    always|never|ask|harness) ;;
    "") add "WARP     .loom/loom.toml: [warp] missing worktree (always|never|ask|harness)" ;;
    *)  add "WARP     .loom/loom.toml: [warp] worktree=$wt invalid (use always|never|ask|harness)" ;;
  esac
  validate_hook_form "$wh"
}

check_weave_config() { # optional [weave] section; required-and-valid iff present.
  # Single-knob section: detect the header itself — an empty [weave] yields no parsed
  # keys, so key-detection (as in check_warp_config) would miss a missing cleanup.
  [ -f "$CONF" ] && grep -q '^\[weave\]' "$CONF" || return 0
  local cl rsi wh
  cl="$(cfg_get weave.cleanup)"
  case "$cl" in
    always|never|ask) ;;
    "") add "WEAVE    .loom/loom.toml: [weave] missing cleanup (always|never|ask)" ;;
    *)  add "WEAVE    .loom/loom.toml: [weave] cleanup=$cl invalid (use always|never|ask)" ;;
  esac
  rsi="$(cfg_get weave.rsi)"   # optional; on by default when unset
  case "$rsi" in
    ""|always|never|ask) ;;
    *)  add "WEAVE    .loom/loom.toml: [weave] rsi=$rsi invalid (use always|never|ask)" ;;
  esac
  wh="$(cfg_get weave.hook)"
  validate_hook_form "$wh"
}

# --- run ---
if [ "$MODE" = "links" ]; then
  # Prospective link check: BROKEN/CODELINK/MISSING only, no frontmatter required, so dress
  # can preview the findings adoption will create before anything is stamped.
  if [ "$#" -gt 0 ]; then
    for arg in "$@"; do
      case "$arg" in
        /*)             f="$arg" ;;                              # absolute, as given
        *) if [ -f "$ROOT/$arg" ]; then f="$ROOT/$arg"          # repo-relative (how dress invokes)
           else f="$PWD/$arg"; fi ;;                             # else relative to cwd
      esac
      [ -f "$f" ] && check_links "$f" || add "INPUT    $arg: no such file"
    done
  else
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      check_links "$ROOT/$rel"
    done < <(doc_universe "$ROOT")
  fi
else
  # full lint of the discovered managed set (current shell, so add() persists)
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    f="$ROOT/$rel"
    k="$(frontmatter_field "$f" kind)"
    check_links "$f"
    check_frontmatter "$f"
    check_placement "$f" "$k"
  done < <(managed_docs "$ROOT")
  check_lint_config
  check_warp_config
  check_weave_config
fi

if [ -z "$FINDINGS" ]; then
  [ "$MODE" = "links" ] && echo "doc-linter --links: clean ✓" || echo "doc-linter: clean ✓"
  exit 0
fi
printf '%s' "$FINDINGS"
exit 1
